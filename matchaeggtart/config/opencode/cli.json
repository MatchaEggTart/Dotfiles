{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "debug": {
    "turn_tokens": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "keybinds": {
    "input.submit": "ctrl+return",
    "input.newline": "return,shift+return,ctrl+j"
  }
}
