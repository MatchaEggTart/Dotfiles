//   _____ _____ _____ _____ _____ _____ _____ _____ _____ 
//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  ARCH  
//
//  by Bina
// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file", // 明确指定为文本 + $n 颜色替换；不写的话会走图片(chafa)探测，去问终端尺寸并等 1s 超时
    "source": "$HOME/.config/fastfetch/ascii/communist",
    "padding": {
      "top": 2,
      "right": 6
    }
  },
  "display": {
    "separator": " ",
    "size": {
      "binaryPrefix": "jedec"
    },
    "percent": {
      "type": 9, // 1=number, 2=bar, 3=both, 9=colored number
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      }
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "33", // = color3
    },
    {
      "type": "cpuusage",
      "key": " ",
      "format": "({avg})",
      "waitTime": 50, // 采样间隔 ms，默认 200；越小出来越快
      "keyColor": "33",
    },
    {
      "type": "command",
      "key": "󰢮 ",
      // 独显 runtime-suspended 时不叫醒它（nvmlInit 把 D3cold 拉起来要 2.5s+）；只在它已经醒着时才读 NVML
      // 想一直只显示型号的话：改回 "type": "gpu", "format": "{name}"
      "text": "v=$(grep -l 0x10de /sys/bus/pci/devices/*/vendor 2>/dev/null | head -n1); s=$(cat \"${v%/vendor}/power/runtime_status\" 2>/dev/null); out=; [ \"$s\" = active ] && out=$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | awk -F', *' 'NF==2{printf \"(%s%%) - %s.0°C\", $1, $2}'); echo \"${out:---}\"",
      "keyColor": "33",
    },
    {
      "type": "memory",
      "format": "({percentage})",
      "key": " ",
      "keyColor": "33",
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "33",
    },
    {
      "type": "localip",
      "key": "IP",
      "format": "{ipv4}",
      "keyColor": "33",
    },
    {
      "type": "media",
      "key": "󰝚 ",
      "format": "{title:52}",
      "keyColor": "33",
    },
    "break",
    "colors",
    "break",
    "break",
  ]
}
